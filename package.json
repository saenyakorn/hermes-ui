{
  "name": "hermes-railway",
  "version": "1.0.0",
  "description": "Hermes Agent Web UI & Control Plane",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "rolldown -c && tailwindcss -i src/styles/app.css -o dist/assets/app.css --minify",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hono/node-server": "^2.0.0",
    "@tailwindcss/cli": "^4.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "hono": "^4.12.15",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.4",
    "xterm": "^5.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "rolldown": "^1.0.0-rc.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
