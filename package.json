{
  "name": "hermes-railway",
  "version": "1.0.0",
  "description": "Hermes Agent Web UI & Control Plane",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,client,css -c blue,magenta,yellow \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:css\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "rolldown -c --watch",
    "dev:css": "tailwindcss -i src/styles/app.css -o dist/assets/app.css --watch=always",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "build": "rolldown -c && tailwindcss -i src/styles/app.css -o dist/assets/app.css --minify && rm -rf dist/assets/monaco/vs && mkdir -p dist/assets/monaco && cp -R node_modules/monaco-editor/min/vs dist/assets/monaco/vs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hono/node-server": "^2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/cli": "^4.2.4",
    "@tanstack/query-core": "^5.100.5",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "hono": "^4.12.15",
    "lucide-react": "^1.12.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-xtermjs": "^1.0.10",
    "shadcn": "^4.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "rolldown": "^1.0.0-rc.17",
    "tsx": "^4.21.0",
    "typed-htmx": "^0.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "dompurify": "3.4.1"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
